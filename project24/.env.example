# ── Claude Vision (verificación de fotos) ───────────────────────────
# Clave de la API de Anthropic. SOLO servidor; nunca se expone al navegador.
ANTHROPIC_API_KEY=
# Modelo usado para verificar las fotos (opcional; por defecto claude-opus-5-5)
ANTHROPIC_MODEL=claude-opus-5-5

# ── Persistencia ───────────────────────────────────────────────────
# Cadena de conexión PostgreSQL (Supabase: Project Settings → Database →
# Connection string → "Transaction pooler"). Las tablas se crean solas.
# Si se deja vacío se usa un archivo local .data/db.json (solo desarrollo).
DATABASE_URL=

# ── Administración ─────────────────────────────────────────────────
# Contraseña del panel /admin (obligatoria para usar el panel)
ADMIN_PASSWORD=
# Secreto para firmar la cookie de sesión del admin (cadena larga aleatoria)
ADMIN_SESSION_SECRET=

# ── Modo demostración ──────────────────────────────────────────────
# Sin ANTHROPIC_API_KEY, en desarrollo las fotos se aceptan SIN análisis y la
# interfaz lo indica claramente. En producción está desactivado salvo que
# pongas ALLOW_DEMO_MODE=true.
ALLOW_DEMO_MODE=
